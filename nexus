    -- Status
    local function setStatus(message, success)
        status.Text = message

        if success then
            status.TextColor3 = Color3.fromRGB(95, 215, 140)
        else
            status.TextColor3 = Color3.fromRGB(225, 105, 115)
        end
    end

    -- =====================================================
    -- LOAD SCRIPT
    -- =====================================================

    local function loadMainScript()

        local ok, err = pcall(function()

            local source = game:HttpGet(MAIN_SCRIPT)

            local fn, loadError = loadstring(source)

            if not fn then
                error(loadError or "Unable to load script.")
            end

            fn()
        end)

        if not ok then
            warn("[Nexus] Script loading error: " .. tostring(err))
            return
        end

        task.wait(0.2)

        showSuccessNotification()
    end

    -- =====================================================
    -- VALIDATE KEY
    -- =====================================================

    local function tryValidate()

        if checking then
            return
        end

        local key = box.Text:gsub("%s+", "")

        if key == "" then
            setStatus("Clé manquante.", false)
            return
        end

        checking = true
        button.Active = false
        button.Text = "Checking..."

        setStatus("Vérification de la clé...", true)

        task.spawn(function()

            local valid, reason = validateKey(key)

            if valid then

                setStatus("Clé valide !", true)

                task.wait(0.4)

                gui:Destroy()

                loadMainScript()

                return
            end

            local messages = {
                invalid_key = "Clé invalide.",
                missing_key = "Clé manquante.",
                hwid_mismatch = "HWID does not match.",
                expired = "Clé expirée.",
                blacklisted = "Clé blacklistée.",
                server_error = "Erreur serveur. Réessayez."
            }

            setStatus(
                messages[reason] or "Clé invalide.",
                false
            )

            checking = false
            button.Active = true
            button.Text = "Validate Key"
        end)
    end

    button.MouseButton1Click:Connect(tryValidate)

    box.FocusLost:Connect(function(enterPressed)

        if enterPressed then
            tryValidate()
        end
    end)

    task.defer(function()

        task.wait(0.25)

        pcall(function()
            box:CaptureFocus()
        end)
    end)
end

