    --------------------------------------------------

    local checking = false

    local function tryValidate()

        if checking then
            return
        end

        local key = box.Text:gsub("%s+", "")

        if key == "" then

            setStatus(
                "Veuillez entrer une clé.",
                false
            )

            return
        end

        checking = true

        button.Text = "Vérification..."

        setStatus("", false)

        task.spawn(function()

            local valid, reason = validateKey(key)

            --------------------------------------------------
            -- VALID KEY
            --------------------------------------------------

            if valid then

                setStatus(
                    "Clé valide ! Chargement de Clover...",
                    true
                )

                task.wait(0.6)

                gui:Destroy()

                onValid()

                return
            end

            --------------------------------------------------
            -- ERROR MESSAGES
            --------------------------------------------------

            local messages = {

                invalid_key =
                    "Clé invalide.",

                missing_key =
                    "Clé manquante.",

                blacklisted =
                    "Clé blacklistée.",

                expired =
                    "Clé expirée.",

                hwid_mismatch =
                    "Clé utilisée sur un autre appareil.",

                server_error =
                    "Erreur serveur. Réessayez."
            }

            setStatus(
                messages[reason] or "Clé invalide.",
                false
            )

            button.Text = "Valider la clé"

            checking = false
        end)
    end

    --------------------------------------------------
    -- BUTTON
    --------------------------------------------------

    button.MouseButton1Click:Connect(
        tryValidate
    )

    --------------------------------------------------
    -- ENTER
    --------------------------------------------------

    box.FocusLost:Connect(function(enterPressed)

        if enterPressed then
            tryValidate()
        end

    end)

    --------------------------------------------------
    -- AUTO FOCUS
    --------------------------------------------------

    task.defer(function()

        pcall(function()
            box:CaptureFocus()
        end)

    end)
end

