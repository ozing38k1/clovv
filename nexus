    card.BorderSizePixel = 0
    card.Parent = background

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = card

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 50, 60)
    stroke.Thickness = 1
    stroke.Parent = card

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 25)
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 20
    title.TextColor3 = Color3.fromRGB(235, 240, 245)
    title.Text = "Clover — Clé d'accès"
    title.Parent = card

    local subtitle = Instance.new("TextLabel")
    subtitle.BackgroundTransparency = 1
    subtitle.Position = UDim2.new(0, 0, 0, 58)
    subtitle.Size = UDim2.new(1, 0, 0, 20)
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextSize = 12
    subtitle.TextColor3 = Color3.fromRGB(140, 150, 160)
    subtitle.Text = "Entrez votre clé pour continuer"
    subtitle.Parent = card

    -- Champ de clé
    local box = Instance.new("TextBox")
    box.Name = "KeyInput"
    box.Position = UDim2.new(0, 30, 0, 95)
    box.Size = UDim2.new(0, 320, 0, 44)
    box.BackgroundColor3 = Color3.fromRGB(30, 33, 40)
    box.BorderSizePixel = 0

    box.Text = ""
    box.PlaceholderText = "CLVR-XXXXX-XXXXX-XXXXX"
    box.PlaceholderColor3 = Color3.fromRGB(100, 105, 115)

    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14

    box.ClearTextOnFocus = false
    box.MultiLine = false

    box.Parent = card

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 8)
    boxCorner.Parent = box

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 12)
    padding.PaddingRight = UDim.new(0, 12)
    padding.Parent = box

    -- Message de statut
    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 30, 0, 148)
    status.Size = UDim2.new(0, 320, 0, 25)
    status.Font = Enum.Font.Gotham
    status.TextSize = 12
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(220, 120, 130)
    status.TextXAlignment = Enum.TextXAlignment.Center
    status.Parent = card

    -- Bouton
    local button = Instance.new("TextButton")
    button.Position = UDim2.new(0, 30, 0, 190)
    button.Size = UDim2.new(0, 320, 0, 44)
    button.BackgroundColor3 = Color3.fromRGB(45, 200, 130)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 15
    button.Text = "Valider la clé"
    button.Parent = card

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = button

    local checking = false

    local function setStatus(message, success)
        status.Text = message

        if success then
            status.TextColor3 = Color3.fromRGB(110, 200, 130)
        else
            status.TextColor3 = Color3.fromRGB(220, 120, 130)
        end
    end

    local function tryValidate()
        if checking then
            return
        end

        local key = box.Text:gsub("%s+", "")

        if key == "" then
            setStatus("Veuillez entrer une clé.", false)
            return
        end

        checking = true
        button.Text = "Vérification..."
        setStatus("", false)

        task.spawn(function()
            local valid, reason = validateKey(key)

            if valid then
                setStatus("Clé valide ! Chargement...", true)

                task.wait(0.5)

                gui:Destroy()

                onValid()
                return
            end

            local messages = {
                invalid_key = "Clé invalide.",
                missing_key = "Clé manquante.",
                hwid_mismatch = "Clé utilisée sur un autre appareil.",
                expired = "Clé expirée.",
                blacklisted = "Clé blacklistée.",
                server_error = "Erreur serveur. Réessayez."
            }

            setStatus(
                messages[reason] or "Clé invalide.",
                false
            )

            button.Text = "Valider la clé"
            checking = false
        end)
    end

    button.MouseButton1Click:Connect(tryValidate)

    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            tryValidate()
        end
    end)
end

-- Lance le script uniquement après validation
showKeyUI(function()

    local ok, err = pcall(function()
        local source = game:HttpGet(MAIN_SCRIPT)

        local execute = loadstring(source)

        if not execute then
            error("Impossible de charger le script.")
        end

        execute()
    end)

    if not ok then
        warn("[CloverHub] Erreur : " .. tostring(err))
    end
end)
