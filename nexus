local VALIDATE_URL =
    "https://sparkling-secure-access-key.base44.app/functions/validateKey"

local MAIN_SCRIPT =
    "https://raw.githubusercontent.com/Ryuun0x/Clover/refs/heads/main/main.lua"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- HTTP
--==================================================

local function sendRequest(url, method, body)
    local requestFunction =
        request
        or http_request
        or (syn and syn.request)
        or (fluxus and fluxus.request)

    if not requestFunction then
        return nil, 0
    end

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = method,
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = body
        })
    end)

    if not success or not response then
        return nil, 0
    end

    return response.Body, response.StatusCode
end

--==================================================
-- HWID
--==================================================

local function getHWID()
    local success, result = pcall(function()
        if typeof(gethwid) == "function" then
            return gethwid()
        end

        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)

    if success and result then
        return tostring(result)
    end

    return "unknown-" .. tostring(LocalPlayer.UserId)
end

--==================================================
-- KEY VALIDATION
--==================================================

local function validateKey(key)
    local payload = {
        key_code = tostring(key):gsub("%s+", ""):upper(),
        hwid = getHWID(),
        username = LocalPlayer.Name
    }

    local encoded

    local encodeSuccess = pcall(function()
        encoded = HttpService:JSONEncode(payload)
    end)

    if not encodeSuccess then
        return false, "server_error"
    end

    local responseBody, statusCode =
        sendRequest(
            VALIDATE_URL,
            "POST",
            encoded
        )

    if not responseBody or statusCode ~= 200 then
        return false, "server_error"
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(responseBody)
    end)

    if not success or type(data) ~= "table" then
        return false, "server_error"
    end

    if data.valid == true then
        return true, data
    end

    return false, data.reason or "invalid_key"
end

