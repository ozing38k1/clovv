-- CloverHub — Key System

local VALIDATE_URL = "https://sparkling-secure-access-key.base44.app/functions/validateKey"

local MAIN_SCRIPT = "https://raw.githubusercontent.com/Dodoyung24/script-core/main/Steal-An-Egg"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- Requête HTTP compatible avec plusieurs environnements
local function httpRequest(url, method, body)
    local requestFn =
        request
        or http_request
        or (syn and syn.request)
        or (fluxus and fluxus.request)

    if not requestFn then
        return nil, 0
    end

    local ok, response = pcall(requestFn, {
        Url = url,
        Method = method,
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = body
    })

    if not ok or not response then
        return nil, 0
    end

    return response.Body, response.StatusCode or 0
end

-- Identifiant de l'utilisateur/appareil
local function getHWID()
    local ok, id = pcall(function()
        if gethwid then
            return gethwid()
        end

        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)

    if ok and id then
        return tostring(id)
    end

    return "unknown-" .. tostring(LocalPlayer.UserId)
end

-- Vérification de la clé
local function validateKey(key)
    local body = HttpService:JSONEncode({
        key_code = key,
        hwid = getHWID(),
        username = LocalPlayer.Name
    })

    local raw, code = httpRequest(VALIDATE_URL, "POST", body)

    if not raw or code ~= 200 then
        return false, "server_error"
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok or not data then
        return false, "server_error"
    end

    return data.valid == true, data.reason
end

