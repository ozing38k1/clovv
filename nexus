-- =========================================================
-- HTTP
-- =========================================================

local function httpRequest(url, method, body, headers)
    local requestFn = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)

    if type(requestFn) ~= "function" then
        return nil, 0, "request_function_missing"
    end

    local ok, response = pcall(function()
        return requestFn({
            Url = url,
            Method = method,
            Headers = headers or {
                ["Content-Type"] = "application/json"
            },
            Body = body
        })
    end)

    if not ok or not response then
        return nil, 0, "request_failed"
    end

    return response.Body, response.StatusCode or 0, response
end

-- =========================================================
-- UTILITIES
-- =========================================================

local function generatePair()
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local result = {}

    for i = 1, 18 do
        local index = math.random(1, #chars)
        result[#result + 1] = chars:sub(index, index)
    end

    return table.concat(result)
end

local function getHWID()
    local ok, id = pcall(function()
        if type(gethwid) == "function" then
            return gethwid()
        end

        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)

    if ok and id then
        return tostring(id)
    end

    return "unknown-" .. tostring(LocalPlayer.UserId)
end

local function formEncode(data)
    local parts = {}
    local function urlEncode(value)
        value = tostring(value or "")
        return value:gsub("([^%w%-%_%.~])", function(char)
            return string.format("%%%02X", string.byte(char))
        end)
    end

    for key, value in pairs(data) do
        table.insert(parts, urlEncode(key) .. "=" .. urlEncode(value))
    end

    return table.concat(parts, "&")
end

local function getGuiParent()
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and result then
            return result
        end
    end

    local ok, result = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok and result then
        return result
    end

    return LocalPlayer:WaitForChild("PlayerGui")
end

-- =========================================================
-- EAUTH REQUEST
-- =========================================================

local function eauthRequest(payload)
    local body = HttpService:JSONEncode(payload)

    local raw, code, response = httpRequest(
        EAUTH_URL,
        "POST",
        body,
        {
            ["Content-Type"] = "application/json",
            ["User-Agent"] = "e_a_u_t_h"
        }
    )

    if not raw then
        return nil, code, response
    end

    if code < 200 or code >= 300 then
        return nil, code, raw
    end

    local ok, json = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok or type(json) ~= "table" then
        return nil, code, raw
    end

    return json, code, raw
end

-- =========================================================
-- EAUTH INIT / VALIDATE
-- =========================================================

local function eauthInit()
    if EAUTH_INITIALIZED and EAUTH_SESSION_ID then
        return true, "init_success"
    end

    local hwid = getHWID()

    local payload = {
        type = "init",
        token = EAUTH_APP_TOKEN,
        hwid = hwid,
        version = EAUTH_VERSION,
        pair = generatePair()
    }

    local response, code = eauthRequest(payload)
    if not response then
        warn("[Nexus] Eauth init failed: " .. tostring(code))
        return false, "server_error"
    end

    local message = tostring(response.message or "")

    if message == "init_success" then
        EAUTH_SESSION_ID = response.session_id
        if not EAUTH_SESSION_ID then
            return false, "server_error"
        end

        EAUTH_INITIALIZED = true
        return true, "init_success"
    end

    if message == "invalid_request" then
        return false, "invalid_request"
    elseif message == "version_outdated" then
        return false, "version_outdated"
    elseif message == "maximum_sessions_reached" then
        return false, "maximum_sessions_reached"
    elseif message == "user_is_banned" then
        return false, "user_is_banned"
    elseif message == "init_paused" then
        return false, "init_paused"
    elseif message == "invalid_account_key" then
        return false, "invalid_account_key"
    elseif message == "invalid_application_key" then
        return false, "invalid_application_key"
    end

    return false, message ~= "" and message or "server_error"
end

local function eauthValidateKey(key)
    key = tostring(key):gsub("%s+", ""):upper()

    if key == "" then
        return false, "missing_key"
    end

    local ok, reason = eauthInit()
    if not ok then
        return false, reason
    end

    local hwid = getHWID()

    local registerPayload = {
        type = "register",
        session_id = EAUTH_SESSION_ID,
        username = key,
        password = key,
        key = key,
        hwid = hwid,
        pair = generatePair()
    }

    local registerResponse = eauthRequest(registerPayload)
    if not registerResponse then
        return false, "server_error"
    end

    local registerMessage = tostring(registerResponse.message or "")

    if registerMessage == "register_success" then
        return true, "valid"
    end

    if registerMessage == "name_already_used" then
        -- continuer vers login
    elseif registerMessage == "key_unavailable" then
        return false, "invalid_key"
    elseif registerMessage == "session_unavailable" then
        return false, "session_unavailable"
    elseif registerMessage == "session_already_used" then
        return false, "session_already_used"
    elseif registerMessage == "session_overcrowded" then
        return false, "maximum_sessions_reached"
    elseif registerMessage == "session_expired" then
        return false, "session_expired"
    elseif registerMessage == "invalid_account_key" then
        return false, "invalid_account_key"
    elseif registerMessage == "maximum_users_reached" then
        return false, "maximum_users_reached"
    elseif registerMessage == "user_is_banned" then
        return false, "blacklisted"
    elseif registerMessage ~= "" then
        return false, registerMessage
    end

    local loginPayload = {
        type = "login",
        session_id = EAUTH_SESSION_ID,
        username = key,
        password = key,
        hwid = hwid,
        pair = generatePair()
    }

    local loginResponse = eauthRequest(loginPayload)
    if not loginResponse then
        return false, "server_error"
    end

    local loginMessage = tostring(loginResponse.message or "")

    if loginMessage == "login_success" then
        return true, "valid"
    end

    if loginMessage == "account_unavailable" then
        return false, "invalid_key"
    elseif loginMessage == "hwid_incorrect" then
        return false, "hwid_mismatch"
    elseif loginMessage == "subscription_expired" then
        return false, "expired"
    elseif loginMessage == "user_is_banned" then
        return false, "blacklisted"
    elseif loginMessage == "session_unavailable" then
        return false, "session_unavailable"
    elseif loginMessage == "session_already_used" then
        return false, "session_already_used"
    elseif loginMessage == "session_overcrowded" then
        return false, "maximum_sessions_reached"
    elseif loginMessage == "session_expired" then
        return false, "session_expired"
    elseif loginMessage == "invalid_request" then
        return false, "invalid_request"
    end

    return false, loginMessage ~= "" and loginMessage or "invalid_key"
end

