    Status.Parent = Card

    -- Validate button
    local Button = Instance.new("TextButton")
    Button.Name = "ValidateButton"
    Button.Size = UDim2.new(1, -50, 0, 45)
    Button.Position = UDim2.new(0, 25, 0, 200)
    Button.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    Button.BorderSizePixel = 0
    Button.Text = "Valider la clé"
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = true
    Button.Parent = Card

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = Button

    -- =====================================================
    -- VALIDATION BUTTON
    -- =====================================================

    local checking = false

    local function setStatus(text, success)
        Status.Text = text

        if success then
            Status.TextColor3 = Color3.fromRGB(100, 220, 140)
        else
            Status.TextColor3 = Color3.fromRGB(240, 90, 90)
        end
    end

    local function executeMainScript()
        local ok, source = pcall(function()
            return game:HttpGet(MAIN_SCRIPT)
        end)

        if not ok or not source then
            setStatus("Impossible de charger le script.", false)
            return
        end

        local execute, compileError = loadstring(source)

        if not execute then
            setStatus("Erreur de chargement du script.", false)
            warn("[CloverHub] Loadstring error:", compileError)
            return
        end

        ScreenGui:Destroy()

        local success, runtimeError = pcall(function()
            execute()
        end)

        if not success then
            warn("[CloverHub] Script error:", runtimeError)
        end
    end

    Button.MouseButton1Click:Connect(function()
        if checking then
            return
        end

        local key = Box.Text

        if not key or key:gsub("%s+", "") == "" then
            setStatus("Clé manquante.", false)
            return
        end

        checking = true
        Button.Text = "Vérification..."
        Button.Active = false

        local valid, reason = validateKey(key)

        if valid then
            setStatus("Clé valide.", true)

            task.wait(0.5)

            executeMainScript()
        else
            if reason == "invalid_key" then
                setStatus("Clé invalide.", false)

            elseif reason == "missing_key" then
                setStatus("Clé manquante.", false)

            elseif reason == "hwid_mismatch" then
                setStatus("Clé utilisée sur un autre appareil.", false)

            elseif reason == "expired" then
                setStatus("Clé expirée.", false)

            elseif reason == "blacklisted" then
                setStatus("Clé blacklistée.", false)

            else
                setStatus("Erreur serveur. Réessayez.", false)
            end
        end

        checking = false
        Button.Text = "Valider la clé"
        Button.Active = true
    end)

    -- Touche Entrée pour valider
    Box.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            Button:Activate()
        end
    end)

    -- Focus automatique
    task.defer(function()
        task.wait(0.2)
        Box:CaptureFocus()
    end)
end

-- =========================================================
-- START
-- =========================================================

createGui()
