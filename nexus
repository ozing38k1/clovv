        showSuccessNotification()
        return true
    end

    local messages = {
        invalid_key = "Clé invalide.",
        missing_key = "Clé manquante.",
        hwid_mismatch = "HWID does not match.",
        expired = "Clé expirée.",
        blacklisted = "Clé blacklistée.",
        server_error = "Erreur serveur. Réessayez.",
        invalid_account_key = "Configuration Eauth invalide.",
        invalid_application_key = "App Token invalide.",
        invalid_request = "Requête Eauth invalide.",
        version_outdated = "Version Eauth obsolète.",
        maximum_sessions_reached = "Trop de sessions actives.",
        session_unavailable = "Session Eauth indisponible.",
        session_already_used = "Session déjà utilisée.",
        session_overcrowded = "Session saturée.",
        session_expired = "Session expirée.",
        maximum_users_reached = "Limite utilisateurs Eauth atteinte.",
        init_paused = "Application Eauth temporairement désactivée.",
        account_unavailable = "Clé invalide ou compte indisponible."
    }

    local function tryValidate()
        if checking then
            return
        end

        local key = box.Text:gsub("%s+", "")

        if key == "" then
            setStatus("Clé manquante.", false)
            return
        end

        checking = true
        button.Active = false
        button.Text = "Checking..."
        setStatus("Connexion à Eauth...", true)

        task.spawn(function()
            local valid, reason = eauthValidateKey(key)

            if valid then
                setStatus("Clé valide !", true)
                task.wait(0.4)

                gui:Destroy()

                local loaded = loadMainScript()
                if not loaded then
                    showKeyUI()
                end

                return
            end

            setStatus(messages[reason] or "Clé invalide.", false)
            checking = false
            button.Active = true
            button.Text = "Validate Key"
        end)
    end

    button.MouseButton1Click:Connect(tryValidate)

    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            tryValidate()
        end
    end)

    task.defer(function()
        task.wait(0.25)
        pcall(function()
            box:CaptureFocus()
        end)
    end)
end

