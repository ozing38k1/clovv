local gui, box, status, button = createMenu()

local checking = false

local function setStatus(message, success)
    status.Text = message

    if success then
        status.TextColor3 = Color3.fromRGB(110, 200, 130)
    else
        status.TextColor3 = Color3.fromRGB(210, 120, 130)
    end
end

local function checkKey()
    if checking then
        return
    end

    local key = box.Text:gsub("%s+", "")

    if key == "" then
        setStatus("Veuillez entrer une clé.", false)
        return
    end

    checking = true
    button.Text = "Vérification..."
    setStatus("", false)

    task.spawn(function()
        local valid, reason = validateKey(key)

        if valid then
            setStatus(
                "Clé valide ! Chargement...",
                true
            )

            task.wait(0.5)

            gui:Destroy()

            local ok, err = pcall(function()
                loadstring(
                    game:HttpGet(MAIN_SCRIPT)
                )()
            end)

            if not ok then
                warn("[Clover] Erreur : " .. tostring(err))
            end

            return
        end

        local messages = {
            invalid_key = "Clé invalide.",
            missing_key = "Clé manquante.",
            hwid_mismatch = "Clé utilisée sur un autre appareil.",
            expired = "Clé expirée.",
            blacklisted = "Clé blacklistée.",
            server_error = "Erreur serveur. Réessayez."
        }

        setStatus(
            messages[reason] or "Clé invalide.",
            false
        )

        button.Text = "Valider la clé"
        checking = false
    end)
end

button.MouseButton1Click:Connect(checkKey)

box.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
    end
end)

task.defer(function()
    box:CaptureFocus()
end)
