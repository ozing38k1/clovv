local VALIDATE_URL =
    "https://sparkling-secure-access-key.base44.app/functions/validateKey"

local MAIN_SCRIPT =
    "https://raw.githubusercontent.com/Dodoyung24/script-core/main/Steal-An-Egg"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- =========================================================
-- HTTP REQUEST
-- =========================================================

local function httpRequest(url, method, body)
    local requestFn =
        request
        or http_request
        or (syn and syn.request)
        or (fluxus and fluxus.request)

    if type(requestFn) ~= "function" then
        return nil, 0
    end

    local ok, response = pcall(function()
        return requestFn({
            Url = url,
            Method = method,
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = body
        })
    end)

    if not ok or not response then
        return nil, 0
    end

    return response.Body, response.StatusCode
end

-- =========================================================
-- HWID
-- =========================================================

local function getHWID()
    local ok, id = pcall(function()
        if type(gethwid) == "function" then
            return gethwid()
        end

        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)

    if ok and id then
        return tostring(id)
    end

    return "unknown-" .. tostring(LocalPlayer.UserId)
end

-- =========================================================
-- VALIDATION
-- =========================================================

local function validateKey(key)
    local body = HttpService:JSONEncode({
        key_code = tostring(key):gsub("%s+", ""):upper(),
        hwid = getHWID(),
        username = LocalPlayer.Name
    })

    local raw, code = httpRequest(
        VALIDATE_URL,
        "POST",
        body
    )

    if not raw or code ~= 200 then
        return false, "server_error"
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok or type(data) ~= "table" then
        return false, "server_error"
    end

    if data.valid == true then
        return true, "valid"
    end

    return false, data.reason or "invalid_key"
end

