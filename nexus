    --==================================================
    -- Status
    --==================================================

    local function setStatus(message, success)
        status.Text = message

        if success then
            status.TextColor3 = Color3.fromRGB(110, 220, 145)
        else
            status.TextColor3 = Color3.fromRGB(230, 110, 120)
        end
    end

    --==================================================
    -- Validation
    --==================================================

    local checking = false

    local function checkKey()
        if checking then
            return
        end

        local key = box.Text:gsub("%s+", "")

        if key == "" then
            setStatus("Veuillez entrer une clé.", false)
            return
        end

        checking = true
        button.Text = "Vérification..."
        button.Active = false
        button.AutoButtonColor = false
        setStatus("", false)

        task.spawn(function()
            local valid, result = validateKey(key)

            if valid then
                setStatus(
                    "Clé valide ! Chargement...",
                    true
                )

                task.wait(0.5)

                gui:Destroy()

                local loaded, errorMessage = pcall(function()
                    local source = game:HttpGet(MAIN_SCRIPT)
                    local execute = loadstring(source)

                    if not execute then
                        error("loadstring indisponible")
                    end

                    execute()
                end)

                if not loaded then
                    warn(
                        "[Clover] Impossible de charger le script : "
                        .. tostring(errorMessage)
                    )
                end

                return
            end

            local reason = tostring(result)

            local messages = {
                invalid_key = "Clé invalide.",
                missing_key = "Clé manquante.",
                blacklisted = "Clé blacklistée.",
                expired = "Clé expirée.",
                hwid_mismatch = "Clé utilisée sur un autre appareil.",
                server_error = "Erreur serveur. Réessayez."
            }

            setStatus(
                messages[reason] or "Clé invalide.",
                false
            )

            button.Text = "Valider la clé"
            button.Active = true
            button.AutoButtonColor = true
            checking = false
        end)
    end

    button.MouseButton1Click:Connect(checkKey)

    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            checkKey()
        end
    end)

    -- Focus automatique
    task.defer(function()
        pcall(function()
            box:CaptureFocus()
        end)
    end)
end

