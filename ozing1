            local valid, reason = validateKey(key)

            if valid then

                setStatus(
                    "Clé valide ! Chargement de Clover...",
                    true
                )

                task.wait(0.6)

                gui:Destroy()

                onValid()

                return
            end

            local messages = {
                invalid_key =
                    "Clé invalide, expirée ou blacklistée.",

                missing_key =
                    "Clé manquante.",

                hwid_mismatch =
                    "Clé utilisée sur un autre appareil.",

                expired =
                    "Clé expirée ou blacklistée.",

                server_error =
                    "Erreur serveur. Réessayez."
            }

            setStatus(
                messages[reason]
                    or "Clé invalide, expirée ou blacklistée.",
                false
            )

            button.Text = "Valider la clé"

            checking = false
        end)
    end

    -- Click
    button.MouseButton1Click:Connect(tryValidate)

    -- Enter
    box.FocusLost:Connect(function(enterPressed)

        if enterPressed then
            tryValidate()
        end

    end)

    -- Focus automatique
    task.defer(function()
        box:CaptureFocus()
    end)
end

